APP_NAME=FactNode
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fn
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

AUTH_TOKEN_TTL_MINUTES=10080
ANALYSES_PER_DAY=10
ANALYSES_CONCURRENT_PER_USER=2
GOOGLE_CLIENT_ID=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Configuration
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=openai
CLAIM_EXTRACTION_PROMPT_VERSION=1.0.0
AI_PROVIDER_TIMEOUT=60
AI_RATE_LIMIT_BACKOFF=60

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.7

# Local PaddleOCR service
# Host Laravel: http://127.0.0.1:8002; Laravel inside Docker: http://ocr-service:8000
OCR_SERVICE_PORT=8002
OCR_SERVICE_URL=http://127.0.0.1:8002
OCR_TIMEOUT=240
OCR_CONNECT_TIMEOUT=10

# OpenAI Configuration (Future use)
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=120

# Google Fact Check Configuration
GOOGLE_FACT_CHECK_ENABLED=false
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_API_BASE_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
GOOGLE_FACT_CHECK_TIMEOUT=20
GOOGLE_FACT_CHECK_CONNECT_TIMEOUT=5

# Search Provider Configuration
SEARCH_PROVIDER_ENABLED=false
SEARCH_PROVIDER_DEFAULT=tavily
SEARCH_PROVIDER_FALLBACK=brave
SEARCH_PROVIDER_TIMEOUT=10
SEARCH_PROVIDER_CONNECT_TIMEOUT=5
SEARCH_PROVIDER_MAX_RESULTS=10

# Tavily Search Configuration
TAVILY_SEARCH_ENABLED=false
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com/search
TAVILY_TIMEOUT=10
TAVILY_CONNECT_TIMEOUT=5
TAVILY_MAX_RESULTS=10

# Brave Search Configuration
BRAVE_SEARCH_ENABLED=false
BRAVE_API_KEY=
BRAVE_API_BASE_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_TIMEOUT=10
BRAVE_CONNECT_TIMEOUT=5
BRAVE_MAX_RESULTS=10

# BERT / ML Service Configuration
# When Laravel runs on Windows (outside Docker): BERT_SERVICE_URL=http://127.0.0.1:8000
# When Laravel runs inside Docker:               BERT_SERVICE_URL=http://ml-service:8000
# The default host port is 8001 because Laravel commonly uses port 8000 locally.
# Override ML_SERVICE_PORT and BERT_SERVICE_URL together if another port is needed.
ML_SERVICE_PORT=8001
BERT_SERVICE_URL=http://127.0.0.1:8001
BERT_TIMEOUT=120
BERT_CONNECT_TIMEOUT=10

# --- FactNode ---
QUEUE_DEV_WORKERS=3
GEMINI_EXTRACTION_TIMEOUT=60
GEMINI_ANALYST_TIMEOUT=150
GEMINI_OCR_TIMEOUT=60
SEARCH_TRUSTED_ONLY=false
# Public API plans
PLAN_FREE_PER_MINUTE=10
PLAN_FREE_ANALYSES_PER_DAY=10
PLAN_PRO_PER_MINUTE=60
PLAN_PRO_ANALYSES_PER_DAY=300
