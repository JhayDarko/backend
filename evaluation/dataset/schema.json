{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factnode.local/evaluation/case.schema.json",
  "title": "Caso de evaluación FactNode",
  "description": "Un registro JSONL de un caso etiquetado. Los ejemplos de estructura se excluyen de las métricas por defecto.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "input_type",
    "url",
    "language",
    "topic",
    "claim_summary",
    "expected_verdict",
    "label_rationale",
    "label_sources",
    "excluded_domains",
    "difficulty",
    "labeler_a",
    "labeler_b",
    "agreement",
    "example"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "split": {
      "type": ["string", "null"],
      "enum": ["dev", "test", null]
    },
    "input_type": {
      "type": "string",
      "enum": ["url", "text"]
    },
    "url": {
      "type": ["string", "null"],
      "maxLength": 2048
    },
    "text_cache_path": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "input_text_hint": {
      "type": ["string", "null"],
      "maxLength": 300
    },
    "status": {
      "type": "string",
      "enum": ["candidato_sin_verificar", "verificado", "descartado"]
    },
    "claim_group": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "label_strength": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "verify_notes": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "country": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "published_at": {
      "type": ["string", "null"],
      "maxLength": 10,
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-([0-2]\\d|3[01]))?$",
      "format": "date-or-month"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "claim_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_verdict": {
      "type": "string",
      "enum": ["credible", "misleading", "false", "inconclusive"]
    },
    "label_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "label_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "original_verdict"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": ["string", "null"],
            "maxLength": 2048
          },
          "original_verdict": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "excluded_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      }
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "labeler_a": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100
    },
    "labeler_b": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100
    },
    "agreement": {
      "type": ["boolean", "null"]
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "example": {
      "type": "boolean"
    }
  }
}
